print with "20 ÷ 4 = " concatenated with to_string with div3.

print with "".
print with "Testing square root operations:".
let sqrt1 be safe_math.safe_sqrt with 16.
print with "√16 = " concatenated with to_string with sqrt1.

let sqrt2 be safe_math.safe_sqrt with -9.  // This will cause an error
if sqrt2 is equal to None then
    print with "Negative square root handled gracefully".
end

let sqrt3 be safe_math.safe_sqrt with 25.
print with "√25 = " concatenated with to_string with sqrt3.

print with "".
print with "Testing factorial operations:".
let fact1 be safe_math.safe_factorial with 5.
print with "5! = " concatenated with to_string with fact1.

let fact2 be safe_math.safe_factorial with -3.  // This will cause an error
if fact2 is equal to None then
    print with "Negative factorial handled gracefully".
end

let fact3 be safe_math.safe_factorial with 25.  // This will cause an error (too large)
if fact3 is equal to None then
    print with "Large factorial handled gracefully".
end

print with "".
print with "Testing array access operations:".
let test_array be Vector.
let len1 be push with test_array, "first".
let len2 be push with test_array, "second".
let len3 be push with test_array, "third".

let access1 be safe_math.safe_array_access with test_array, 1.
print with "Array[1] = " concatenated with access1.

let access2 be safe_math.safe_array_access with test_array, -1.  // This will cause an error
if access2 is equal to None then
    print with "Negative array index handled gracefully".
end

let access3 be safe_math.safe_array_access with test_array, 10.  // This will cause an error
if access3 is equal to None then
    print with "Out of bounds array access handled gracefully".
end

// Show error summary
print with "".
let math_summary be safe_math.get_error_summary.
print with "=== Mathematical Operations Summary ===".
print with "Total operations: " concatenated with to_string with math_summary["total_operations"].
print with "Successful operations: " concatenated with to_string with math_summary["successful_operations"].
print with "Errors encountered: " concatenated with to_string with math_summary["error_count"].
print with "Success rate: " concatenated with to_string with math_summary["success_rate"] concatenated with "%".

safe_math.print_error_log.

print with "".
print with "2. Input Validation Demo".

let validator be new InputValidator.

// Set up validation rules
validator.add_rule with "username", "min_length", 3.
validator.add_rule with "username", "max_length", 20.
validator.add_rule with "age", "min_value", 0.
validator.add_rule with "age", "max_value", 150.
validator.add_rule with "email", "min_length", 5.

print with "Validation rules configured:".
print with "- Username: 3-20 characters".
print with "- Age: 0-150".
print with "- Email: minimum 5 characters".

// Test valid data
print with "".
print with "Testing valid user data:".
let valid_user be Table.
set valid_user["username"] to "alice_smith".
set valid_user["age"] to 25.
set valid_user["email"] to "alice@example.com".

let is_valid1 be validator.validate_all with valid_user.
if is_valid1 is equal to 1 then
    print with "✅ Valid user data passed validation".
otherwise
    print with "❌ Valid user data failed validation (unexpected)".
    validator.print_validation_errors.
end

// Test invalid data
print with "".
print with "Testing invalid user data:".
let invalid_user be Table.
set invalid_user["username"] to "ab".  // Too short
set invalid_user["age"] to 200.       // Too high
set invalid_user["email"] to "x".     // Too short

let is_valid2 be validator.validate_all with invalid_user.
if is_valid2 is equal to 0 then
    print with "❌ Invalid user data correctly rejected".
    validator.print_validation_errors.
otherwise
    print with "✅ Invalid user data incorrectly passed (unexpected)".
end

print with "".
print with "3. Error Recovery Demonstration".

// Demonstrate graceful error recovery in a complex operation
to define DataProcessor:
    property processed_items with Vector.
    property error_count with 0.
    property recovery_count with 0.
    
    to process_item with item:
        // Simulate various processing scenarios
        let item_type be type_of with item.
        
        if item_type is equal to "string" or item_type is equal to "String" then
            let item_length be length with item.
            if item_length is equal to 0 then
                set self.error_count to self.error_count plus 1.
                print with "⚠️  Empty string detected, using default value".
                set self.recovery_count to self.recovery_count plus 1.
                let len be push with self.processed_items, "DEFAULT".
                return "recovered".
            end
            
            let processed be to_upper with item.
            let len be push with self.processed_items, processed.
            return "success".
            
        otherwise if item_type is equal to "number" or item_type is equal to "Number" then
            if item is less than 0 then
                set self.error_count to self.error_count plus 1.
                print with "⚠️  Negative number detected, using absolute value".
                set self.recovery_count to self.recovery_count plus 1.
                let abs_value be abs with item.
                let len be push with self.processed_items, abs_value.
                return "recovered".
            end
            
            let len be push with self.processed_items, item.
            return "success".
            
        otherwise
            set self.error_count to self.error_count plus 1.
            print with "❌ Unknown data type, skipping item".
            return "error".
        end
    end
    
    to process_batch with items:
        let item_count be length with items.
        let success_count be 0.
        let recovery_count be 0.
        let error_count be 0.
        
        print with "Processing batch of " concatenated with to_string with item_count concatenated with " items:".
        
        let i be 0.
        while i is less than item_count:
            let item be items[i].
            let result be self.process_item with item.
            
            if result is equal to "success" then
                set success_count to success_count plus 1.
            otherwise if result is equal to "recovered" then
                set recovery_count to recovery_count plus 1.
            otherwise
                set error_count to error_count plus 1.
            end
            
            set i to i plus 1.
        end
        
        print with "Batch processing complete:".
        print with "  ✅ Successful: " concatenated with to_string with success_count.
        print with "  🔧 Recovered: " concatenated with to_string with recovery_count.
        print with "  ❌ Errors: " concatenated with to_string with error_count.
        
        return success_count plus recovery_count.
    end
    
    to get_processed_items:
        return self.processed_items.
    end
end

let processor be new DataProcessor.

// Create a mixed batch with various data types and error conditions
let mixed_batch be Vector.
let len4 be push with mixed_batch, "hello".      // Valid string
let len5 be push with mixed_batch, "".           // Empty string (error)
let len6 be push with mixed_batch, "world".      // Valid string
let len7 be push with mixed_batch, 42.           // Valid number
let len8 be push with mixed_batch, -15.          // Negative number (error)
let len9 be push with mixed_batch, "engage".     // Valid string
let len10 be push with mixed_batch, 0.           // Valid number

let processed_count be processor.process_batch with mixed_batch.
print with "Successfully processed " concatenated with to_string with processed_count concatenated with " items".

let processed_items be processor.get_processed_items.
let final_count be length with processed_items.
print with "Final processed items (" concatenated with to_string with final_count concatenated with "):".

let j be 0.
while j is less than final_count:
    let item be processed_items[j].
    let item_num be j plus 1.
    print with "  " concatenated with to_string with item_num concatenated with ": " concatenated with to_string with item.
    set j to j plus 1.
end

print with "".
print with "4. Stack Trace Simulation".

// Simulate a call stack for error tracing
to define CallStackTracker:
    property call_stack with Vector.
    property max_depth with 10.
    
    to push_call with function_name:
        let stack_depth be length with self.call_stack.
        if stack_depth is greater than or equal to self.max_depth then
            print with "❌ Stack overflow detected! Maximum call depth exceeded.".
            return 0.
        end
        
        let len be push with self.call_stack, function_name.
        return 1.
    end
    
    to pop_call:
        let stack_depth be length with self.call_stack.
        if stack_depth is greater than 0 then
            let popped be pop with self.call_stack.
            return popped.
        end
        return None.
    end
    
    to print_stack_trace:
        let stack_depth be length with self.call_stack.
        
        if stack_depth is equal to 0 then
            print with "Call stack is empty".
            return.
        end
        
        print with "=== Stack Trace ===".
        let i be stack_depth minus 1.
        while i is greater than or equal to 0:
            let function_name be self.call_stack[i].
            let level be stack_depth minus i.
            print with "  " concatenated with to_string with level concatenated with ". " concatenated with function_name.
            set i to i minus 1.
        end
    end
end

let stack_tracker be new CallStackTracker.

// Simulate a series of function calls
print with "Simulating function call chain:".
let call1 be stack_tracker.push_call with "main()".
let call2 be stack_tracker.push_call with "process_data()".
let call3 be stack_tracker.push_call with "validate_input()".
let call4 be stack_tracker.push_call with "check_format()".

print with "Error occurred in check_format()!".
stack_tracker.print_stack_trace.

print with "".
print with "🎯 Error Handling Showcase Complete!".
print with "Successfully demonstrated:".
print with "  ✓ Safe mathematical operations with error handling".
print with "  ✓ Input validation with detailed error messages".
print with "  ✓ Graceful error recovery mechanisms".
print with "  ✓ Comprehensive error logging and reporting".
print with "  ✓ Stack trace simulation for debugging".
print with "  ✓ Multiple error handling strategies working together".