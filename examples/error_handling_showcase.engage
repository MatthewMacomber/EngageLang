// error_handling_showcase.engage
// Comprehensive demonstration of enhanced error reporting and handling
// This program showcases various error scenarios and recovery mechanisms

print with "=== Error Handling Showcase Demo ===".

// Define a record for safe mathematical operations
to define SafeMathOperations:
    property error_log with Vector.
    property operation_count with 0.
    property success_count with 0.
    
    to log_error with operation, error_message:
        let error_entry be Table.
        set error_entry["operation"] to operation.
        set error_entry["error"] to error_message.
        set error_entry["timestamp"] to self.operation_count.
        
        let len be push with self.error_log, error_entry.
        print with "❌ Error logged: " concatenated with operation concatenated with " - " concatenated with error_message.
        return len.
    end
    
    to safe_divide with numerator, denominator:
        set self.operation_count to self.operation_count plus 1.
        
        if denominator is equal to 0 then
            let error_len be self.log_error with "division", "Division by zero is undefined".
            return None.
        end
        
        set self.success_count to self.success_count plus 1.
        return numerator divided by denominator.
    end
    
    to safe_sqrt with value:
        set self.operation_count to self.operation_count plus 1.
        
        if value is less than 0 then
            let error_len be self.log_error with "square_root", "Square root of negative number is undefined".
            return None.
        end
        
        set self.success_count to self.success_count plus 1.
        return sqrt with value.
    end
    
    to safe_factorial with n:
        set self.operation_count to self.operation_count plus 1.
        
        if n is less than 0 then
            let error_len be self.log_error with "factorial", "Factorial is not defined for negative numbers".
            return None.
        end
        
        if n is greater than 20 then
            let error_len be self.log_error with "factorial", "Factorial calculation would overflow for numbers > 20".
            return None.
        end
        
        set self.success_count to self.success_count plus 1.
        
        if n is equal to 0 or n is equal to 1 then
            return 1.
        end
        
        let result be 1.
        let i be 2.
        while i is less than or equal to n:
            set result to result times i.
            set i to i plus 1.
        end
        
        return result.
    end
    
    to safe_array_access with array, index:
        set self.operation_count to self.operation_count plus 1.
        
        let array_length be length with array.
        
        if index is less than 0 then
            let error_len be self.log_error with "array_access", "Array index cannot be negative".
            return None.
        end
        
        if index is greater than or equal to array_length then
            let error_len be self.log_error with "array_access", "Array index out of bounds".
            return None.
        end
        
        set self.success_count to self.success_count plus 1.
        return array[index].
    end
    
    to get_error_summary:
        let error_count be length with self.error_log.
        let success_rate be 0.
        
        if self.operation_count is greater than 0 then
            set success_rate to self.success_count times 100 divided by self.operation_count.
        end
        
        let summary be Table.
        set summary["total_operations"] to self.operation_count.
        set summary["successful_operations"] to self.success_count.
        set summary["error_count"] to error_count.
        set summary["success_rate"] to success_rate.
        
        return summary.
    end
    
    to print_error_log:
        let error_count be length with self.error_log.
        
        if error_count is equal to 0 then
            print with "✅ No errors recorded!".
            return.
        end
        
        print with "=== Error Log ===".
        let i be 0.
        while i is less than error_count:
            let error_entry be self.error_log[i].
            let entry_num be i plus 1.
            
            print with "Error " concatenated with to_string with entry_num concatenated with ":".
            print with "  Operation: " concatenated with error_entry["operation"].
            print with "  Message: " concatenated with error_entry["error"].
            print with "  Timestamp: " concatenated with to_string with error_entry["timestamp"].
            
            set i to i plus 1.
        end
    end
end

// Define a record for input validation
to define InputValidator:
    property validation_rules with Table.
    property validation_errors with Vector.
    
    to add_rule with field_name, rule_type, rule_value:
        let rule be Table.
        set rule["type"] to rule_type.
        set rule["value"] to rule_value.
        set self.validation_rules[field_name] to rule.
    end
    
    to validate_field with field_name, value:
        let rule be self.validation_rules[field_name].
        
        if rule is equal to None then
            return 1.  // No rule means valid
        end
        
        let rule_type be rule["type"].
        let rule_value be rule["value"].
        
        if rule_type is equal to "min_length" then
            let value_length be length with value.
            if value_length is less than rule_value then
                let error_msg be field_name concatenated with " must be at least " concatenated with to_string with rule_value concatenated with " characters".
                let len be push with self.validation_errors, error_msg.
                return 0.
            end
            
        otherwise if rule_type is equal to "max_length" then
            let value_length be length with value.
            if value_length is greater than rule_value then
                let error_msg be field_name concatenated with " must be no more than " concatenated with to_string with rule_value concatenated with " characters".
                let len be push with self.validation_errors, error_msg.
                return 0.
            end
            
        otherwise if rule_type is equal to "min_value" then
            if value is less than rule_value then
                let error_msg be field_name concatenated with " must be at least " concatenated with to_string with rule_value.
                let len be push with self.validation_errors, error_msg.
                return 0.
            end
            
        otherwise if rule_type is equal to "max_value" then
            if value is greater than rule_value then
                let error_msg be field_name concatenated with " must be no more than " concatenated with to_string with rule_value.
                let len be push with self.validation_errors, error_msg.
                return 0.
            end
        end
        
        return 1.
    end
    
    to validate_all with data:
        // Clear previous errors
        set self.validation_errors to Vector.
        
        let field_names be keys with data.
        let field_count be length with field_names.
        let all_valid be 1.
        
        let i be 0.
        while i is less than field_count:
            let field_name be field_names[i].
            let field_value be data[field_name].
            
            let is_valid be self.validate_field with field_name, field_value.
            if is_valid is equal to 0 then
                set all_valid to 0.
            end
            
            set i to i plus 1.
        end
        
        return all_valid.
    end
    
    to get_validation_errors:
        return self.validation_errors.
    end
    
    to print_validation_errors:
        let error_count be length with self.validation_errors.
        
        if error_count is equal to 0 then
            print with "✅ All validation passed!".
            return.
        end
        
        print with "❌ Validation Errors:".
        let i be 0.
        while i is less than error_count:
            let error_msg be self.validation_errors[i].
            print with "  - " concatenated with error_msg.
            set i to i plus 1.
        end
    end
end

// === Demo Execution ===

print with "1. Safe Mathematical Operations Demo".

let safe_math be new SafeMathOperations.

// Test various mathematical operations with error conditions
print with "Testing division operations:".
let div1 be safe_math.safe_divide with 10, 2.
print with "10 ÷ 2 = " concatenated with to_string with div1.

