// game_ui_showcase.engage
// Comprehensive demonstration of UI components and game object systems
// This program showcases the complete UI and game development capabilities

print with "=== Game UI Showcase Demo ===".

// Define a game character record
to define GameCharacter:
    property name with "Player".
    property position_x with 0.
    property position_y with 0.
    property health with 100.
    property max_health with 100.
    property level with 1.
    property experience with 0.
    property inventory with Vector.
    
    to move_to with x, y:
        set self.position_x to x.
        set self.position_y to y.
        print with self.name concatenated with " moved to (" concatenated with to_string with x concatenated with ", " concatenated with to_string with y concatenated with ")".
    end
    
    to take_damage with amount:
        set self.health to self.health minus amount.
        if self.health is less than 0 then
            set self.health to 0.
        end
        print with self.name concatenated with " took " concatenated with to_string with amount concatenated with " damage. Health: " concatenated with to_string with self.health.
    end
    
    to heal with amount:
        set self.health to self.health plus amount.
        if self.health is greater than self.max_health then
            set self.health to self.max_health.
        end
        print with self.name concatenated with " healed " concatenated with to_string with amount concatenated with " HP. Health: " concatenated with to_string with self.health.
    end
    
    to add_item with item_name:
        let len be push with self.inventory, item_name.
        print with "Added " concatenated with item_name concatenated with " to inventory".
        return len.
    end
    
    to get_health_percentage:
        return self.health times 100 divided by self.max_health.
    end
end

// Define a UI manager record
to define GameUIManager:
    property main_window with None.
    property ui_components with Table.
    property character_ref with None.
    property ui_initialized with 0.
    
    to initialize_ui:
        // Create main game window
        set self.main_window to create_panel.
        ui_set_property with self.main_window, "width", 800.
        ui_set_property with self.main_window, "height", 600.
        ui_set_property with self.main_window, "x", 50.
        ui_set_property with self.main_window, "y", 50.
        
        // Create header panel
        let header_panel be create_panel.
        ui_set_property with header_panel, "x", 0.
        ui_set_property with header_panel, "y", 0.
        ui_set_property with header_panel, "width", 800.
        ui_set_property with header_panel, "height", 80.
        set self.ui_components["header"] to header_panel.
        
        // Create game title
        let title_label be create_label with "Epic Adventure Game".
        ui_set_property with title_label, "x", 300.
        ui_set_property with title_label, "y", 20.
        ui_set_property with title_label, "width", 200.
        set self.ui_components["title"] to title_label.
        
        // Create character info panel
        let char_panel be create_panel.
        ui_set_property with char_panel, "x", 10.
        ui_set_property with char_panel, "y", 90.
        ui_set_property with char_panel, "width", 250.
        ui_set_property with char_panel, "height", 200.
        set self.ui_components["char_panel"] to char_panel.
        
        // Character name label
        let name_label be create_label with "Character: Unknown".
        ui_set_property with name_label, "x", 10.
        ui_set_property with name_label, "y", 10.
        ui_set_property with name_label, "width", 200.
        set self.ui_components["name_label"] to name_label.
        
        // Health label
        let health_label be create_label with "Health: 100/100".
        ui_set_property with health_label, "x", 10.
        ui_set_property with health_label, "y", 40.
        ui_set_property with health_label, "width", 200.
        set self.ui_components["health_label"] to health_label.
        
        // Level label
        let level_label be create_label with "Level: 1".
        ui_set_property with level_label, "x", 10.
        ui_set_property with level_label, "y", 70.
        ui_set_property with level_label, "width", 200.
        set self.ui_components["level_label"] to level_label.
        
        // Position label
        let pos_label be create_label with "Position: (0, 0)".
        ui_set_property with pos_label, "x", 10.
        ui_set_property with pos_label, "y", 100.
        ui_set_property with pos_label, "width", 200.
        set self.ui_components["pos_label"] to pos_label.
        
        // Create action buttons panel
        let action_panel be create_panel.
        ui_set_property with action_panel, "x", 280.
        ui_set_property with action_panel, "y", 90.
        ui_set_property with action_panel, "width", 200.
        ui_set_property with action_panel, "height", 300.
        set self.ui_components["action_panel"] to action_panel.
        
        // Movement buttons
        let move_up_btn be create_button with "Move Up".
        ui_set_property with move_up_btn, "x", 60.
        ui_set_property with move_up_btn, "y", 10.
        ui_set_property with move_up_btn, "width", 80.
        set self.ui_components["move_up"] to move_up_btn.
        
        let move_down_btn be create_button with "Move Down".
        ui_set_property with move_down_btn, "x", 60.
        ui_set_property with move_down_btn, "y", 80.
        ui_set_property with move_down_btn, "width", 80.
        set self.ui_components["move_down"] to move_down_btn.
        
        let move_left_btn be create_button with "Move Left".
        ui_set_property with move_left_btn, "x", 10.
        ui_set_property with move_left_btn, "y", 45.
        ui_set_property with move_left_btn, "width", 80.
        set self.ui_components["move_left"] to move_left_btn.
        
        let move_right_btn be create_button with "Move Right".
        ui_set_property with move_right_btn, "x", 110.
        ui_set_property with move_right_btn, "y", 45.
        ui_set_property with move_right_btn, "width", 80.
        set self.ui_components["move_right"] to move_right_btn.
        
        // Action buttons
        let heal_btn be create_button with "Heal (+20 HP)".
        ui_set_property with heal_btn, "x", 10.
        ui_set_property with heal_btn, "y", 120.
        ui_set_property with heal_btn, "width", 120.
        set self.ui_components["heal"] to heal_btn.
        
        let damage_btn be create_button with "Take Damage".
        ui_set_property with damage_btn, "x", 10.
        ui_set_property with damage_btn, "y", 160.
        ui_set_property with damage_btn, "width", 120.
        set self.ui_components["damage"] to damage_btn.
        
        // Inventory panel
        let inv_panel be create_panel.
        ui_set_property with inv_panel, "x", 500.
        ui_set_property with inv_panel, "y", 90.
        ui_set_property with inv_panel, "width", 280.
        ui_set_property with inv_panel, "height", 400.
        set self.ui_components["inventory_panel"] to inv_panel.
        
        let inv_title be create_label with "Inventory".
        ui_set_property with inv_title, "x", 10.
        ui_set_property with inv_title, "y", 10.
        ui_set_property with inv_title, "width", 100.
        set self.ui_components["inv_title"] to inv_title.
        
        let add_item_btn be create_button with "Add Random Item".
        ui_set_property with add_item_btn, "x", 10.
        ui_set_property with add_item_btn, "y", 350.
        ui_set_property with add_item_btn, "width", 150.
        set self.ui_components["add_item"] to add_item_btn.
        
        // Add all components to their parents
        ui_add_child with header_panel, title_label.
        ui_add_child with char_panel, name_label.
        ui_add_child with char_panel, health_label.
        ui_add_child with char_panel, level_label.
        ui_add_child with char_panel, pos_label.
        
        ui_add_child with action_panel, move_up_btn.
        ui_add_child with action_panel, move_down_btn.
        ui_add_child with action_panel, move_left_btn.
        ui_add_child with action_panel, move_right_btn.
        ui_add_child with action_panel, heal_btn.
        ui_add_child with action_panel, damage_btn.
        
        ui_add_child with inv_panel, inv_title.
        ui_add_child with inv_panel, add_item_btn.
        
        ui_add_child with self.main_window, header_panel.
        ui_add_child with self.main_window, char_panel.
        ui_add_child with self.main_window, action_panel.
        ui_add_child with self.main_window, inv_panel.
        
        set self.ui_initialized to 1.
        print with "✓ Game UI initialized successfully".
    end
    
    to set_character with character:
        set self.character_ref to character.
        self.update_character_display.
    end
    
    to update_character_display:
        if self.character_ref is not equal to None then
            let char be self.character_ref.
            
            // Update name
            let name_text be "Character: " concatenated with char.name.
            ui_set_text with self.ui_components["name_label"], name_text.
            
            // Update health
            let health_text be "Health: " concatenated with to_string with char.health concatenated with "/" concatenated with to_string with char.max_health.
            ui_set_text with self.ui_components["health_label"], health_text.
            
            // Update level
            let level_text be "Level: " concatenated with to_string with char.level.
            ui_set_text with self.ui_components["level_label"], level_text.
            
            // Update position
            let pos_text be "Position: (" concatenated with to_string with char.position_x concatenated with ", " concatenated with to_string with char.position_y concatenated with ")".
            ui_set_text with self.ui_components["pos_label"], pos_text.
        end
    end
    
    to simulate_button_click with button_name:
        print with "🖱️  Simulating click on " concatenated with button_name concatenated with " button".
        
        if button_name is equal to "move_up" then
            let char be self.character_ref.
            char.move_to with char.position_x, char.position_y plus 1.
            
        otherwise if button_name is equal to "move_down" then
            let char be self.character_ref.
            char.move_to with char.position_x, char.position_y minus 1.
            
        otherwise if button_name is equal to "move_left" then
            let char be self.character_ref.
            char.move_to with char.position_x minus 1, char.position_y.
            
        otherwise if button_name is equal to "move_right" then
            let char be self.character_ref.
            char.move_to with char.position_x plus 1, char.position_y.
            
        otherwise if button_name is equal to "heal" then
            let char be self.character_ref.
            char.heal with 20.
            
        otherwise if button_name is equal to "damage" then
            let char be self.character_ref.
            char.take_damage with 15.
            
        otherwise if button_name is equal to "add_item" then
            let char be self.character_ref.
            let random_items be Vector.
            let len1 be push with random_items, "Health Potion".
            let len2 be push with random_items, "Magic Sword".
            let len3 be push with random_items, "Shield".
            let len4 be push with random_items, "Gold Coin".
            let len5 be push with random_items, "Ancient Scroll".
            
            // Simple random selection (using position as seed)
            let item_count be length with random_items.
            let seed be char.position_x plus char.position_y.
            let index be seed modulo item_count.
            let selected_item be random_items[index].
            
            char.add_item with selected_item.
        end
        
        self.update_character_display.
    end
    
    to get_ui_summary:
        let component_count be size with self.ui_components.
        return "UI has " concatenated with to_string with component_count concatenated with " components initialized".
    end
end

// Define a simple game object for demonstration
to define GameObject:
    property object_id with "obj_0".
    property position_x with 0.
    property position_y with 0.
    property width with 32.
    property height with 32.
    property sprite_name with "default".
    property is_active with 1.
    
    to set_position with x, y:
        set self.position_x to x.
        set self.position_y to y.
    end
    
    to get_bounds:
        let bounds be Table.
        set bounds["left"] to self.position_x.
        set bounds["right"] to self.position_x plus self.width.
        set bounds["top"] to self.position_y.
        set bounds["bottom"] to self.position_y plus self.height.
        return bounds.
    end
    
    to collides_with with other:
        let my_bounds be self.get_bounds.
        let other_bounds be other.get_bounds.
        
        // Simple AABB collision detection
        let no_collision be 0.
        
        if my_bounds["right"] is less than other_bounds["left"] then
            set no_collision to 1.
        end
        if my_bounds["left"] is greater than other_bounds["right"] then
            set no_collision to 1.
        end
        if my_bounds["bottom"] is less than other_bounds["top"] then
            set no_collision to 1.
        end
        if my_bounds["top"] is greater than other_bounds["bottom"] then
            set no_collision to 1.
        end
        
        if no_collision is equal to 1 then
            return 0.
        end
        return 1.
    end
    
    to update:
        // Override in subclasses for game logic
        print with "Updating " concatenated with self.object_id.
    end
end

// === Main Demo Execution ===

print with "1. Creating Game Character".
let hero be new GameCharacter.
set hero.name to "Brave Adventurer".
set hero.position_x to 10.
set hero.position_y to 5.

print with "Character created: " concatenated with hero.name.
print with "Starting position: (" concatenated with to_string with hero.position_x concatenated with ", " concatenated with to_string with hero.position_y concatenated with ")".

print with "".
print with "2. Initializing Game UI".
let ui_manager be new GameUIManager.
ui_manager.initialize_ui.
ui_manager.set_character with hero.

let ui_summary be ui_manager.get_ui_summary.
print with ui_summary.

print with "".
print with "3. Simulating User Interactions".

// Simulate a series of button clicks
let button_sequence be Vector.
let len6 be push with button_sequence, "move_right".
let len7 be push with button_sequence, "move_right".
let len8 be push with button_sequence, "move_up".
let len9 be push with button_sequence, "damage".
let len10 be push with button_sequence, "heal".
let len11 be push with button_sequence, "add_item".
let len12 be push with button_sequence, "move_left".
let len13 be push with button_sequence, "add_item".

let i be 0.
let sequence_length be length with button_sequence.
while i is less than sequence_length:
    let button be button_sequence[i].
    ui_manager.simulate_button_click with button.
    print with "".
    set i to i plus 1.
end

print with "4. Game Object System Demo".

// Create some game objects
let player_obj be new GameObject.
set player_obj.object_id to "player".
player_obj.set_position with hero.position_x times 32, hero.position_y times 32.

let treasure_obj be new GameObject.
set treasure_obj.object_id to "treasure".
set treasure_obj.sprite_name to "treasure_chest".
treasure_obj.set_position with 12 times 32, 5 times 32.

let enemy_obj be new GameObject.
set enemy_obj.object_id to "enemy".
set enemy_obj.sprite_name to "goblin".
enemy_obj.set_position with 11 times 32, 6 times 32.

print with "Created game objects:".
print with "- Player at (" concatenated with to_string with player_obj.position_x concatenated with ", " concatenated with to_string with player_obj.position_y concatenated with ")".
print with "- Treasure at (" concatenated with to_string with treasure_obj.position_x concatenated with ", " concatenated with to_string with treasure_obj.position_y concatenated with ")".
print with "- Enemy at (" concatenated with to_string with enemy_obj.position_x concatenated with ", " concatenated with to_string with enemy_obj.position_y concatenated with ")".

// Test collision detection
print with "".
print with "Testing collision detection:".
let player_treasure_collision be player_obj.collides_with with treasure_obj.
let player_enemy_collision be player_obj.collides_with with enemy_obj.
let treasure_enemy_collision be treasure_obj.collides_with with enemy_obj.

if player_treasure_collision is equal to 1 then
    print with "✓ Player is colliding with treasure!".
    hero.add_item with "Ancient Treasure".
otherwise
    print with "- Player is not colliding with treasure".
end

if player_enemy_collision is equal to 1 then
    print with "⚔️  Player is colliding with enemy! Combat initiated!".
    hero.take_damage with 25.
otherwise
    print with "- Player is not colliding with enemy".
end

if treasure_enemy_collision is equal to 1 then
    print with "- Treasure and enemy are colliding".
otherwise
    print with "- Treasure and enemy are not colliding".
end

print with "".
print with "5. Final Game State".

// Show final character state
print with "=== Final Character Status ===".
print with "Name: " concatenated with hero.name.
print with "Position: (" concatenated with to_string with hero.position_x concatenated with ", " concatenated with to_string with hero.position_y concatenated with ")".
print with "Health: " concatenated with to_string with hero.health concatenated with "/" concatenated with to_string with hero.max_health.
print with "Level: " concatenated with to_string with hero.level.

let inventory_size be length with hero.inventory.
print with "Inventory (" concatenated with to_string with inventory_size concatenated with " items):".
let j be 0.
while j is less than inventory_size:
    let item be hero.inventory[j].
    print with "  - " concatenated with item.
    set j to j plus 1.
end

let health_percentage be hero.get_health_percentage.
print with "Health percentage: " concatenated with to_string with health_percentage concatenated with "%".

print with "".
print with "🎮 Game UI Showcase Demo Complete!".
print with "Successfully demonstrated:".
print with "  ✓ Complex UI component hierarchy".
print with "  ✓ Character management system".
print with "  ✓ Interactive button simulation".
print with "  ✓ Game object creation and management".
print with "  ✓ Collision detection system".
print with "  ✓ Real-time UI updates".
print with "  ✓ Integration of UI and game logic".